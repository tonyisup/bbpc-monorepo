# Shared BBPC Convex deployment used by the browser and server routes.
NEXT_PUBLIC_CONVEX_URL=

# Clerk application shared with the primary BBPC applications. The Clerk
# instance must expose a JWT template named "convex" with audience "convex".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME_SOUNDERS=sounders
AZURE_STORAGE_CONTAINER_NAME_RECORDINGS=recordings

# Peer-to-peer mesh audio / TURN
NEXT_PUBLIC_RTC_AUDIO_ENABLED=true
TURN_URLS=
STUN_URLS=
TURN_STATIC_AUTH_SECRET=
TURN_TTL_SECONDS=3600
