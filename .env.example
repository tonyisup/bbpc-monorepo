# Convex deployment URL used by the browser and maintenance scripts.
NEXT_PUBLIC_CONVEX_URL=

# Configure the same random value in the Next.js runtime and Convex deployment.
# Generate with: openssl rand -base64 32
SESSION_ADMIN_SECRET=

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME_SOUNDERS=sounders
AZURE_STORAGE_CONTAINER_NAME_RECORDINGS=recordings

# Peer-to-peer mesh audio / TURN
NEXT_PUBLIC_RTC_AUDIO_ENABLED=true
TURN_URLS=
STUN_URLS=
TURN_STATIC_AUTH_SECRET=
TURN_TTL_SECONDS=3600
RTC_CLEANUP_ADMIN_SECRET=
