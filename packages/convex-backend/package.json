{
  "name": "@tonyisup/bbpc-convex-api",
  "version": "0.1.0",
  "description": "Shared Convex backend and generated API contract for BBPC",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "contracts/index.d.ts",
    "contracts/index.js",
    "contracts/generated/convexApi.d.ts",
    "contracts/generated/convexApi.js",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./contracts/generated/convexApi.d.ts",
      "import": "./contracts/generated/convexApi.js"
    },
    "./contracts": {
      "types": "./contracts/index.d.ts",
      "import": "./contracts/index.js"
    }
  },
  "scripts": {
    "dev": "convex dev",
    "dev:local": "convex dev",
    "codegen": "convex codegen",
    "contract:build": "tsc --project tsconfig.contract.json",
    "contract:compare": "node scripts/compare-public-contract.mjs",
    "contract:generate": "convex-helpers ts-api-spec --output-file contracts/convexApi.ts",
    "deploy:environment:check": "node scripts/check-deployment-environment.mjs",
    "deploy:production:authorization:check": "node scripts/check-production-deploy-authorization.mjs",
    "deploy:staging:verify-authenticated": "node scripts/verify-authenticated-staging.mjs",
    "deploy:staging:verify": "node scripts/verify-staging-deployment.mjs",
    "deploy:target:check": "node scripts/check-deploy-target.mjs",
    "deployment:test": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:queries": "node scripts/check-convex-queries.mjs",
    "lint:access": "node scripts/check-access-classification.mjs",
    "migration:extract:identity": "node local-tools/sql/extract-identity.mjs",
    "migration:extract:catalog": "node local-tools/sql/extract-catalog.mjs",
    "migration:extract:episodes": "node local-tools/sql/extract-episodes.mjs",
    "migration:extract:assignments": "node local-tools/sql/extract-assignments.mjs",
    "migration:extract:reviews": "node local-tools/sql/extract-reviews.mjs",
    "migration:extract:games": "node local-tools/sql/extract-games.mjs",
    "migration:extract:rankings": "node local-tools/sql/extract-rankings.mjs",
    "migration:extract:archive": "node local-tools/sql/extract-archive.mjs",
    "migration:recording-catalogs": "node local-tools/recording/import-catalogs.mjs",
    "migration:recording-archive": "node local-tools/recording/archive-source.mjs",
    "migration:recording-archive:restore": "node local-tools/recording/restore-source-archive.mjs",
    "migration:stage:local": "node local-tools/sql/stage-local.mjs",
    "migration:rehearse:local": "node local-tools/sql/rehearse-local.mjs",
    "migration:backup:local": "node local-tools/sql/portable-backup-local.mjs",
    "migration:restore:local": "node local-tools/sql/portable-restore-local.mjs",
    "migration:validate:identity:local": "node local-tools/performance/validate-authenticated-rehearsal.mjs",
    "migration:test:extractor": "node --test local-tools/sql/*.test.mjs",
    "migration:test:recording": "node --test local-tools/recording/*.test.mjs",
    "staging:fixture:prepare": "node local-tools/staging/synthetic-fixture.mjs",
    "staging:initialize:synthetic": "node local-tools/staging/initialize-synthetic-staging.mjs",
    "staging:test": "node --test local-tools/staging/*.test.mjs",
    "performance:benchmark:public": "node local-tools/performance/benchmark-public.mjs",
    "performance:benchmark:authenticated": "node local-tools/performance/benchmark-authenticated.mjs",
    "performance:test": "node --test local-tools/performance/*.test.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run lint:queries && pnpm run lint:access && pnpm run deployment:test && pnpm run migration:test:extractor && pnpm run migration:test:recording && pnpm run staging:test && pnpm run performance:test && pnpm run test:coverage",
    "package:check": "pnpm run contract:build && node scripts/check-package.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "convex": "1.42.3",
    "convex-helpers": "0.1.120"
  },
  "devDependencies": {
    "@bbpc/movie-search-hints": "workspace:*",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "9.39.5",
    "@types/node": "22.19.11",
    "@vitest/coverage-v8": "4.1.10",
    "convex-test": "0.0.54",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
