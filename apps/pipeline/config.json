{
  "paths": {
    "episodes_dir": "./episodes",
    "output_dir": "./output",
    "transcripts_dir": "./transcripts",
    "movie_extractions_dir": "./output/movies",
    "seo_dir": "./output/seo"
  },
  "settings": {
    "transcription_engine": "parakeet",
    "parakeet_model": "mlx-community/parakeet-tdt-0.6b-v2",
    "whisper_model": "large-v3-turbo",
    "clip_duration": 60,
    "clip_audio_fade_out_seconds": 0.8,
    "visuals_provider": "openrouter",
    "openrouter_visual_model": "google/gemini-3.1-flash-image",
    "openai_visual_model": "gpt-image-1",
    "openai_image_size": "1024x1536",
    "openai_image_quality": "high",
    "local_visual_model": "stabilityai/sdxl-turbo",
    "local_visual_script": "./scripts/generate_local_visual.py",
    "local_visual_steps": 8,
    "local_visual_seed": 42,
    "local_visual_width": 768,
    "local_visual_height": 1344,
    "visual_style_suffix": "Vertical 9:16 abstract cinematic poster art, bold contrast, dramatic composition, symbolic objects and surreal environments grounded in the spoken subject. Never depict people podcasting, hosts at microphones, recording studios, boom arms, or headphones. No text, letters, numbers, typography, logos, captions, titles, watermarks, fake UI, or media player chrome. Subtitles are added separately.",
    "brand_logo_enabled": true,
    "brand_logo_path": "assets/BBPC-LOGO-cropped-transparentbg-5000px.png",
    "brand_logo_margin_px": 48,
    "brand_logo_max_width_fraction": 0.38,
    "brand_logo_max_height_fraction": 0.14,
    "thumbnail_enabled": true,
    "thumbnail_logo_max_width_fraction": 0.22,
    "thumbnail_logo_max_height_fraction": 0.12,
    "thumbnail_logo_margin_px": 40,
    "thumbnail_logo_position": "top_right",
    "cowork_outputs_dir": "./output/cowork"
  }
}
