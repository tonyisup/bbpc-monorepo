# Episodes, transcripts, and output live here, outside the checkout.
# Its .env is loaded after apps/pipeline/.env, so every worktree shares it; set
# this variable in the shell or in apps/pipeline/.env, not in that shared file.
BBPC_PIPELINE_DATA_DIR=~/src/bbpc/bbpc-pipeline-data

AZURE_STORAGE_CONNECTION_STRING=
CONVEX_URL=https://your-deployment.convex.cloud
# Independent pins for the transcript importer; change them deliberately.
BBPC_EXPECTED_CONVEX_URL=https://your-deployment.convex.cloud
BBPC_EXPECTED_CONVEX_DEPLOYMENT=your-deployment
# Set exactly one of these. The machine secret enables automatic short-lived JWT refresh.
CONVEX_PIPELINE_TOKEN=
CLERK_MACHINE_SECRET_KEY=
CLERK_M2M_AUDIENCE=mch_your-convex-receiver
CLERK_M2M_TOKEN_TTL_SECONDS=900
CLERK_M2M_REFRESH_MARGIN_SECONDS=60
CONVEX_TIMEOUT_SECONDS=30
CONVEX_MAX_ATTEMPTS=3
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# The Lab's YouTube uploads (README, "Publishing to YouTube"); the refresh token comes from scripts/youtube_auth.py.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
