# Copy this file to .env and populate the values. Never commit secrets.

# Convex and Clerk are the only application backend and identity provider.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CONVEX_URL=

# File uploads used by profile images and voice messages.
UPLOADTHING_TOKEN=

# Optional analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional audio limit in seconds.
NEXT_PUBLIC_MAX_RECORDING_TIME=300
