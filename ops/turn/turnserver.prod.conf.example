# coturn production template for bbpc-recording.
#
# Replace the placeholder values, then install as /etc/turnserver.conf or the
# platform-specific coturn config path. The TURN_STATIC_AUTH_SECRET value must
# exactly match the app server environment variable.

listening-port=3478

# Optional TURNS support. Uncomment only after installing a valid certificate.
# tls-listening-port=5349
# cert=/etc/letsencrypt/live/turn.example.com/fullchain.pem
# pkey=/etc/letsencrypt/live/turn.example.com/privkey.pem

# For a public VPS with a single public interface, leave listening-ip/relay-ip
# unset. If the VPS is behind NAT, set external-ip=PUBLIC_IP/PRIVATE_IP.
# external-ip=203.0.113.10/10.0.0.10

min-port=49160
max-port=49260

fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_TURN_STATIC_AUTH_SECRET
realm=turn.example.com
server-name=turn.example.com

stale-nonce=600
max-allocate-lifetime=3600
no-multicast-peers

# Prevent the TURN server from being used as a proxy to private infrastructure.
# Do not copy these denied-peer-ip rules into the local development config.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=224.0.0.0-239.255.255.255
denied-peer-ip=240.0.0.0-255.255.255.255

log-file=/var/log/turnserver/turnserver.log
simple-log
new-log-timestamp
